function substituirNomeSegundaColuna() {
  const templates = {
    "Limpeza": { templateId: "1wQOwLXe0zMrfQJtyEiU1BvkpFhuLzLe9Th4wX2R3bpI", folderId: "1czA4vsdFBjD_Kcp482XMWUnLiXHo0Amj" },
    "Carpintaria": { templateId: "1XGEo-rNEqMCBIWDRR_iEUDmK4wUbcuqeTeJWfACEKZY", folderId: "1DuBvADZtKHsCzYthb3rAcJudPs0RGbjP" },
    "Manutenção Geral": { templateId: "1XGEo-rNEqMCBIWDRR_iEUDmK4wUbcuqeTeJWfACEKZY", folderId: "1DuBvADZtKHsCzYthb3rAcJudPs0RGbjP" },
    "Eletricista": { templateId: "1bw5yI3hrkGNSZwnmQq3xJsil5WtrAARTH27Q5WHoRzU", folderId: "1jcRbOD8tBgEebQrh8K9zCQTnEgq_oFDN" },
    "Empregado de Mesa": { templateId: "1iebHeIdxFVimzuG2DQ5_XgpZayOlTr5jhYf1nUa2ucw", folderId: "1xKaqVmZOXrx2QifPb-BmXQbtp9a_ccMU" },
    "Auxiliar de Cozinha": { templateId: "1joeyLisknlNZ9y3a0Mrx5RgxID5h0RHmMJyXgIFHqtg", folderId: "1eMUxcSl81JFymtKpkdc95qb-6en7L4g_" }
  };

  const planilhaBaseId = "1ttdzp88wQNfkPhAASA0Vx2rJKikZgEqvDiuPiN38hD4";
  const planilhaDestinoId = "1OqvIJNNgXVYxZ8hlSH6BdQf5NhR5kaEhyvWCXKVaz5s";
  const planilhaBase = SpreadsheetApp.openById(planilhaBaseId);
  const abaBase = planilhaBase.getActiveSheet();
  const dadosBase = abaBase.getDataRange().getValues();

  const planilhaDestino = SpreadsheetApp.openById(planilhaDestinoId);
  const abaDestino = planilhaDestino.getActiveSheet();

  const dataAtual = new Date();
  const dataFormatada = Utilities.formatDate(dataAtual, Session.getScriptTimeZone(), "dd'.'MM'.'yyyy");

  const pastasCache = {}; // Cache para armazenar referências de pastas
  const linhasParaRemover = []; // Array para rastrear linhas a serem removidas

  for (let i = 1; i < dadosBase.length; i++) {
    const nome = (dadosBase[i][4] || "").toUpperCase(); // Converte o nome para maiúsculas
    const passaporte = dadosBase[i][1] || ""; // Obtém o passaporte
    const cargo = (dadosBase[i][12] || "").trim(); // Remove espaços extras
    const nomeArquivo = `MINUTA PROMESSA DE CONTRATO DE TRABALHO - ${nome}`;

    // Verifica se o cargo está no objeto templates
    const templateInfo = templates[cargo];
    if (!templateInfo) {
      console.error(`Cargo não encontrado no template: "${cargo}" na linha ${i + 1}`);
      continue;
    }

    const { templateId, folderId } = templateInfo;

    // Cache de pasta para evitar chamadas repetidas
    let pastaBase = pastasCache[folderId];
    if (!pastaBase) {
      pastaBase = DriveApp.getFolderById(folderId);
      pastasCache[folderId] = pastaBase;
    }

    // Criação ou obtenção da subpasta
    const nomeSubpasta = `${passaporte} - ${nome}`;
    let subpastaDestino;
    const pastasSub = pastaBase.getFoldersByName(nomeSubpasta);
    if (pastasSub.hasNext()) {
      subpastaDestino = pastasSub.next();
    } else {
      subpastaDestino = pastaBase.createFolder(nomeSubpasta);
    }

    // Remove arquivos duplicados na subpasta
    const arquivosExistentes = subpastaDestino.getFilesByName(nomeArquivo);
    while (arquivosExistentes.hasNext()) {
      arquivosExistentes.next().setTrashed(true);
    }

    // Cria uma cópia do template
    const templateDoc = DriveApp.getFileById(templateId);
    const novoDoc = templateDoc.makeCopy(nomeArquivo, subpastaDestino);
    const doc = DocumentApp.openById(novoDoc.getId());
    const body = doc.getBody();

    // Substituições no documento
    const placeholders = {
      "{{Nome}}": nome,
      "{{Status Civil}}": dadosBase[i][5],
      "{{Passaporte1}}": passaporte,
      "{{PassaporteDt}}": dadosBase[i][2],
      "{{Morada1}}": dadosBase[i][7],
      "{{Cidade}}": dadosBase[i][8],
      "{{CodigoPostal}}": dadosBase[i][9],
      "{{Provincia}}": dadosBase[i][10],
      "{{Data}}": dataFormatada
    };

    for (const [key, value] of Object.entries(placeholders)) {
      body.replaceText(key, value || "");
    }

    doc.saveAndClose();

    // Criação do PDF
    const pdfBlob = DriveApp.getFileById(novoDoc.getId()).getAs("application/pdf");

    // Remove PDFs duplicados na subpasta
    const arquivosPdfExistentes = subpastaDestino.getFilesByName(`${nomeArquivo}.pdf`);
    while (arquivosPdfExistentes.hasNext()) {
      arquivosPdfExistentes.next().setTrashed(true);
    }

    // Salva o PDF na subpasta
    subpastaDestino.createFile(pdfBlob).setName(`${nomeArquivo}.pdf`);

    // Copia os dados para a planilha destino
    abaDestino.appendRow(dadosBase[i]);

    // Marca a linha para remoção
    linhasParaRemover.push(i + 1); // Compensa o índice base 1
  }

  // Remove as linhas marcadas na planilha base (de trás para frente para evitar mudanças de índice)
  for (let i = linhasParaRemover.length - 1; i >= 0; i--) {
    abaBase.deleteRow(linhasParaRemover[i]);
  }
}
