      arquivosExistentes.next().setTrashed(true);
    }

    // Cria uma cópia do template
    const templateDoc = DriveApp.getFileById(templateId);
    const novoDoc = templateDoc.makeCopy(nomeArquivo, subpastaDestino);
    const doc = DocumentApp.openById(novoDoc.getId());
    const body = doc.getBody();

    // Substituições no documento
   const placeholders = {
    "{{Nome}}": nome,
    "{{Status Civil}}": dadosBase[i][5],
