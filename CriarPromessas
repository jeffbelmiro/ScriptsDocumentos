function substituirNomeSegundaColuna() {
  const templates = {
    "Limpeza": { templateId: "1wQOwLXe0zMrfQJtyEiU1BvkpFhuLzLe9Th4wX2R3bpI", folderId: "1czA4vsdFBjD_Kcp482XMWUnLiXHo0Amj" },
    "Carpintaria": { templateId: "1XGEo-rNEqMCBIWDRR_iEUDmK4wUbcuqeTeJWfACEKZY", folderId: "1DuBvADZtKHsCzYthb3rAcJudPs0RGbjP" },
    "Manutenção Geral": { templateId: "1XGEo-rNEqMCBIWDRR_iEUDmK4wUbcuqeTeJWfACEKZY", folderId: "1DuBvADZtKHsCzYthb3rAcJudPs0RGbjP" },
    "Eletricista": { templateId: "1bw5yI3hrkGNSZwnmQq3xJsil5WtrAARTH27Q5WHoRzU", folderId: "1jcRbOD8tBgEebQrh8K9zCQTnEgq_oFDN" },
    "Empregado de Mesa": { templateId: "1iebHeIdxFVimzuG2DQ5_XgpZayOlTr5jhYf1nUa2ucw", folderId: "1xKaqVmZOXrx2QifPb-BmXQbtp9a_ccMU" },
    "Auxiliar de Cozinha": { templateId: "1joeyLisknlNZ9y3a0Mrx5RgxID5h0RHmMJyXgIFHqtg", folderId: "1eMUxcSl81JFymtKpkdc95qb-6en7L4g_" }
  };

  const planilha = SpreadsheetApp.openById("1ttdzp88wQNfkPhAASA0Vx2rJKikZgEqvDiuPiN38hD4");
  const aba = planilha.getActiveSheet();
  const dados = aba.getDataRange().getValues();
  const dataAtual = new Date();
  const dataFormatada = Utilities.formatDate(dataAtual, Session.getScriptTimeZone(), "dd'.'MM'.'yyyy");

  const pastasCache = {}; // Cache para armazenar referências de pastas
  
  for (let i = 1; i < dados.length; i++) {
    const nome = (dados[i][1] || "").toUpperCase(); // Converte o nome para maiúsculas
    const cargo = dados[i][11]; // Obtém o cargo da 12ª coluna
    const nomeArquivo = `MINUTA PROMESSA DE CONTRATO DE TRABALHO - ${nome}`;
    const templateInfo = templates[cargo];
    
    if (!templateInfo) continue; // Pule cargos não suportados

    const { templateId, folderId } = templateInfo;

    // Cache de pasta para evitar chamadas repetidas
    let pastaDestino = pastasCache[folderId];
    if (!pastaDestino) {
      pastaDestino = DriveApp.getFolderById(folderId);
      pastasCache[folderId] = pastaDestino;
    }

    // Remove arquivos duplicados na pasta
    const arquivosExistentes = pastaDestino.getFilesByName(nomeArquivo);
    while (arquivosExistentes.hasNext()) {
      arquivosExistentes.next().setTrashed(true);
    }

    // Cria uma cópia do template
    const templateDoc = DriveApp.getFileById(templateId);
    const novoDoc = templateDoc.makeCopy(nomeArquivo, pastaDestino);
    const doc = DocumentApp.openById(novoDoc.getId());
    const body = doc.getBody();

    // Substituições no documento
    const placeholders = {
      "{{Nome}}": nome,
      "{{Status Civil}}": dados[i][2],
      "{{Passaporte1}}": dados[i][4],
      "{{PassaporteDt}}": dados[i][5],
      "{{Morada1}}": dados[i][7],
      "{{Cidade}}": dados[i][8],
      "{{Provincia}}": dados[i][9],
      "{{Data}}": dataFormatada
    };

    for (const [key, value] of Object.entries(placeholders)) {
      body.replaceText(key, value || "");
    }

    doc.saveAndClose();

    // Criação do PDF
    const pdfBlob = DriveApp.getFileById(novoDoc.getId()).getAs("application/pdf");

    // Remove PDFs duplicados
    const arquivosPdfExistentes = pastaDestino.getFilesByName(`${nomeArquivo}.pdf`);
    while (arquivosPdfExistentes.hasNext()) {
      arquivosPdfExistentes.next().setTrashed(true);
    }

    // Salva o PDF na pasta de destino
    pastaDestino.createFile(pdfBlob).setName(`${nomeArquivo}.pdf`);
  }
}
